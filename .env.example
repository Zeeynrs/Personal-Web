# Supabase → Project Settings → API (atau tombol "Connect")
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable / anon key. Aman di frontend karena dilindungi RLS.
# JANGAN pernah memakai service_role / secret key di sini.
VITE_SUPABASE_ANON_KEY=

# Opsional, hanya dipakai bila Supabase TIDAK diisi: endpoint form kontak (mis. Formspree).
# Jika keduanya kosong, tombol "Kirim Pesan" membuka aplikasi email pengunjung (mailto).
VITE_CONTACT_ENDPOINT=
